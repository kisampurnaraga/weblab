const SHEET_ID = '1Q7oDUs0JvGWTRXulkAMANyu1WyJKSXuONwxYqX3khc4';
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const body=JSON.parse(e.postData.contents||'{}');const expected=PropertiesService.getScriptProperties().getProperty('WEBLAB_SECRET');if(!expected||body.secret!==expected)return json({ok:false,error:'Unauthorized'});const map={findStudentByUsername,createStudent,touchLogin,getProgress,saveProgress,logActivity};if(!map[body.action])return json({ok:false,error:'Unknown action'});return json({ok:true,data:map[body.action](body)});}catch(err){return json({ok:false,error:String(err&&err.message||err)})}}
function ss(){return SpreadsheetApp.openById(SHEET_ID)}
function rows(name){const sh=ss().getSheetByName(name);const values=sh.getDataRange().getValues();const headers=values.shift()||[];return {sh,headers,values}}
function obj(headers,row){const out={};headers.forEach((h,i)=>out[h]=row[i]);return out}
function findStudentByUsername(b){const r=rows('Siswa');const i=r.headers.indexOf('username');const row=r.values.find(x=>String(x[i]).toLowerCase()===String(b.username).toLowerCase());return row?obj(r.headers,row):null}
function createStudent(b){const r=rows('Siswa');const s=b.student;r.sh.appendRow(r.headers.map(h=>s[h]??''));return s}
function touchLogin(b){const r=rows('Siswa');const id=r.headers.indexOf('student_id'),col=r.headers.indexOf('last_login_at');const n=r.values.findIndex(x=>x[id]===b.studentId);if(n<0)return false;r.sh.getRange(n+2,col+1).setValue(new Date().toISOString());return true}
function emptyProgress(){return {completedLessons:[],quizScores:{},xp:0}}
function getProgress(b){const r=rows('Progress');const a=r.headers.indexOf('student_id'),c=r.headers.indexOf('lesson_id'),p=r.headers.indexOf('payload_json');const row=r.values.find(x=>x[a]===b.studentId&&x[c]==='__summary__');if(!row)return emptyProgress();try{return JSON.parse(row[p]||'{}')}catch(e){return emptyProgress()}}
function saveProgress(b){const r=rows('Progress');const h=r.headers;const a=h.indexOf('student_id'),c=h.indexOf('lesson_id');const now=new Date().toISOString();const progress=b.progress||emptyProgress();const summary={student_id:b.studentId,course_id:'python',lesson_id:'__summary__',status:'sedang_belajar',quiz_score:'',xp:Number(progress.xp||0),completed_at:'',updated_at:now,payload_json:JSON.stringify(progress)};upsert(r.sh,h,a,c,b.studentId,'__summary__',summary);const ids={};(progress.completedLessons||[]).forEach(x=>ids[x]=true);Object.keys(progress.quizScores||{}).forEach(x=>ids[x]=true);Object.keys(ids).forEach(id=>{const done=(progress.completedLessons||[]).indexOf(id)>=0;const row={student_id:b.studentId,course_id:'python',lesson_id:id,status:done?'lulus':'sedang_belajar',quiz_score:progress.quizScores[id]??'',xp:'',completed_at:done?now:'',updated_at:now,payload_json:'{}'};upsert(r.sh,h,a,c,b.studentId,id,row)});return progress}
function upsert(sh,headers,idCol,lessonCol,studentId,lessonId,data){const values=sh.getDataRange().getValues().slice(1);const idx=values.findIndex(x=>x[idCol]===studentId&&x[lessonCol]===lessonId);const arr=headers.map(h=>data[h]??'');if(idx<0)sh.appendRow(arr);else sh.getRange(idx+2,1,1,headers.length).setValues([arr])}
function logActivity(b){const sh=ss().getSheetByName('Aktivitas');sh.appendRow(['EVT-'+Utilities.getUuid().slice(0,8).toUpperCase(),b.studentId,b.eventType||'',b.referenceId||'',new Date().toISOString(),JSON.stringify(b.metadata||{})]);return true}
